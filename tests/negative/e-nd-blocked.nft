#!/usr/sbin/nft -f
# tests/negative/e-nd-blocked.nft
#
# Defect class E, deliberately, and nothing else.
#
# This is the scenario 03 expert with one substitution: neighbour solicitation
# and advertisement are dropped instead of accepted. Every other rule is
# correct on both families.
#
# It exists to prove two things at once.
#
# First, that E is detectable on its own. Without a control like this, an
# ICMPv6 failure is indistinguishable from an over-blocking policy, because a
# dead IPv6 link fails allow-probes and passes drop-probes vacuously.
#
# Second, that the lab's pinned neighbour entries actually work. If they do,
# every flow probe still passes here - the host is still reachable over IPv6
# because resolution is not on the path - and exactly one probe fails, the
# neighbour-discovery probe.
#
#     sudo bash harness/run.sh bench/scenarios/03-db-server \
#          --config tests/negative/e-nd-blocked.nft --reset
#
# Expected: exit 1, defects=[E], ipv4=pass, 40/41, and the only failing probe
# is ipv6-neighbour-discovery.

flush ruleset

table inet filter {

	chain input {
		type filter hook input priority filter; policy drop;

		iifname "lo" accept

		ct state established,related accept
		ct state invalid drop

		# The defect: discovery is refused, not accepted.
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } drop

		tcp dport 5432 accept

		ip  saddr 10.20.0.0/24     tcp dport 22 accept
		ip6 saddr 2001:db8:20::/64 tcp dport 22 accept

		ip  saddr 10.20.0.0/24     icmp   type echo-request accept
		ip6 saddr 2001:db8:20::/64 icmpv6 type echo-request accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}
