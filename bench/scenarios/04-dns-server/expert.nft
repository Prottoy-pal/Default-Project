#!/usr/sbin/nft -f
# ---------------------------------------------------------------------------
# bench/scenarios/04-dns-server/expert.nft
#
# Hand-written reference for scenario 04: DNS open on both transports, SSH and
# echo restricted to the administrator network by an explicit negative match,
# base policy accept, no forwarding.
#
# GATE: must pass 100% of expected.yaml - 12 probes, 23 packets - before any
# model is prompted.
#
# The shape to notice: every restriction is written twice, once as an allow
# and once as a refusal, and each of those appears once per family. That is
# what "default accept" costs. A model that writes the refusal only for IPv4
# produces a file that reads like a refusal and behaves like an invitation.
# ---------------------------------------------------------------------------

flush ruleset

table inet filter {

	chain input {
		type filter hook input priority filter; policy accept;

		iifname "lo" accept

		ct state established,related accept
		ct state invalid drop

		icmpv6 type { nd-router-solicit, nd-router-advert,
		              nd-neighbor-solicit, nd-neighbor-advert } accept

		# --- DNS: any source, both transports ---------------------------
		udp dport 53 accept
		tcp dport 53 accept

		# --- SSH: administrator network only, both families -------------
		ip  saddr 10.20.0.0/24        tcp dport 22 accept
		ip6 saddr 2001:db8:20::/64    tcp dport 22 accept
		ip  saddr != 10.20.0.0/24     tcp dport 22 drop
		ip6 saddr != 2001:db8:20::/64 tcp dport 22 drop

		# --- Echo: administrator network only, both families ------------
		ip  saddr 10.20.0.0/24        icmp   type echo-request accept
		ip6 saddr 2001:db8:20::/64    icmpv6 type echo-request accept
		ip  saddr != 10.20.0.0/24     icmp   type echo-request drop
		ip6 saddr != 2001:db8:20::/64 icmpv6 type echo-request drop

		# Nothing else is refused, because the policy is accept. That is
		# the instruction, not an oversight.
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}
