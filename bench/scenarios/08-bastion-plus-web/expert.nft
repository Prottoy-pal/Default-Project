#!/usr/sbin/nft -f
# ---------------------------------------------------------------------------
# bench/scenarios/08-bastion-plus-web/expert.nft
#
# Hand-written reference for scenario 08: SSH open to any source, the
# management interface scoped to the administrator network, default drop, no
# forwarding.
#
# GATE: must pass 100% of expected.yaml - 13 probes, 35 packets - before any
# model is prompted.
#
# The shape to notice: the open service carries no address match, and the
# scoped service carries one per family. That is the correct split between the
# two, and it is exactly where a family-blind model gets it wrong.
# ---------------------------------------------------------------------------

flush ruleset

table inet filter {

	chain input {
		type filter hook input priority filter; policy drop;

		iifname "lo" accept

		ct state established,related accept
		ct state invalid drop

		icmpv6 type { nd-router-solicit, nd-router-advert,
		              nd-neighbor-solicit, nd-neighbor-advert } accept

		# --- the point of a bastion: SSH from anywhere ---------------
		tcp dport 22 accept

		# --- the management interface: administrator network only ----
		ip  saddr 10.20.0.0/24     tcp dport 443 accept
		ip6 saddr 2001:db8:20::/64 tcp dport 443 accept

		# --- echo: administrator network only ------------------------
		ip  saddr 10.20.0.0/24     icmp   type echo-request accept
		ip6 saddr 2001:db8:20::/64 icmpv6 type echo-request accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}
