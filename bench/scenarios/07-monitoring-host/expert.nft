#!/usr/sbin/nft -f
# ---------------------------------------------------------------------------
# bench/scenarios/07-monitoring-host/expert.nft
#
# Hand-written reference for scenario 07: metrics and SSH restricted to the
# administrator network by explicit negative matches, echo open to all, base
# policy accept, no forwarding.
#
# GATE: must pass 100% of expected.yaml - 11 probes, 21 packets - before any
# model is prompted.
#
# Two ports are scoped, so the refusal appears four times. That is the point:
# a model can write one of these correctly and the next one for IPv4 only, and
# the oracle records which.
# ---------------------------------------------------------------------------

flush ruleset

table inet filter {

	chain input {
		type filter hook input priority filter; policy accept;

		iifname "lo" accept

		ct state established,related accept
		ct state invalid drop

		icmpv6 type { nd-router-solicit, nd-router-advert,
		              nd-neighbor-solicit, nd-neighbor-advert } accept

		# --- metrics endpoint: administrator network only --------------
		ip  saddr 10.20.0.0/24        tcp dport 9100 accept
		ip6 saddr 2001:db8:20::/64    tcp dport 9100 accept
		ip  saddr != 10.20.0.0/24     tcp dport 9100 drop
		ip6 saddr != 2001:db8:20::/64 tcp dport 9100 drop

		# --- SSH: administrator network only ---------------------------
		ip  saddr 10.20.0.0/24        tcp dport 22 accept
		ip6 saddr 2001:db8:20::/64    tcp dport 22 accept
		ip  saddr != 10.20.0.0/24     tcp dport 22 drop
		ip6 saddr != 2001:db8:20::/64 tcp dport 22 drop

		# Echo is permitted from anywhere, which `policy accept` already
		# does. Nothing is written for it, deliberately.
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}
