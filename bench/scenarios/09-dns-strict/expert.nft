#!/usr/sbin/nft -f
# ---------------------------------------------------------------------------
# bench/scenarios/09-dns-strict/expert.nft
#
# Hand-written reference for scenario 09: DNS open on both transports, SSH and
# echo scoped to the administrator network, default drop.
#
# GATE: must pass 100% of expected.yaml - 14 probes, 37 packets - before any
# model is prompted.
# ---------------------------------------------------------------------------

flush ruleset

table inet filter {

	chain input {
		type filter hook input priority filter; policy drop;

		iifname "lo" accept

		ct state established,related accept
		ct state invalid drop

		icmpv6 type { nd-router-solicit, nd-router-advert,
		              nd-neighbor-solicit, nd-neighbor-advert } accept

		# --- DNS: any source, both transports ---------------------------
		udp dport 53 accept
		tcp dport 53 accept

		# --- SSH: administrator network only, both families -------------
		ip  saddr 10.20.0.0/24     tcp dport 22 accept
		ip6 saddr 2001:db8:20::/64 tcp dport 22 accept

		# --- Echo: administrator network only, both families ------------
		ip  saddr 10.20.0.0/24     icmp   type echo-request accept
		ip6 saddr 2001:db8:20::/64 icmpv6 type echo-request accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
	}
}
